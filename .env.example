# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_APP_DB=garden_app
MONGODB_KNOWLEDGE_DB=gardening_knowledge

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Embeddings & Vector Search
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
VECTOR_INDEX_NAME=plant_health_knowledge_vector_index
CLIMATE_VECTOR_INDEX_NAME=climate_location_knowledge_vector_index

# Context Summarizer
SUMMARY_MESSAGE_THRESHOLD=6
RECENT_MESSAGES_WINDOW=4

# Server
PORT=3000
